{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MarkPoint",
  "version": "0.2.0",
  "identifier": "com.markpoint.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkPoint",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: http: https:; font-src 'self' data:; media-src 'self' blob: data: http: https:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Presentaciones desde Markdown",
    "longDescription": "MarkPoint crea presentaciones de diapositivas a partir de Markdown, con vista previa en vivo, maquetación con imágenes, temas y modo presentación.",
    "fileAssociations": [
      {
        "ext": ["markpoint"],
        "name": "MarkPoint Presentation",
        "description": "Presentación de MarkPoint",
        "mimeType": "application/zip",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
